APP_ENV=development
APP_NAME=Production Agentic RAG Platform
DEFAULT_MODEL=llama3.2:3b
DEFAULT_TOP_K=3
MAX_TOP_K=10
MAX_RETRIEVAL_ATTEMPTS=3
GUARDRAIL_THRESHOLD=70
GUARDRAIL_FAIL_CLOSED=true
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=rag-chunks
OPENSEARCH_NEURAL_MODEL_ID=
OPENSEARCH_VECTOR_FIELD=embedding
OPENSEARCH_SEARCH_PIPELINE=
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
INGESTION_CHUNK_SIZE=1200
INGESTION_CHUNK_OVERLAP=200
MAX_UPLOAD_BYTES=20000000
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
AUTH_ENABLED=false
API_KEY_SHA256=
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
